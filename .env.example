# ABSENT_ALERTS=off           # отключить «не пришёл» родителям и кураторам
# ABSENT_ALERT_DELAY=60       # через сколько минут после начала занятий группы проверять
# BACKUP_CRON=off             # отключить еженедельный бэкап базы в Telegram (вс 03:00)
# BACKUP_PASSWORD=            # пароль шифрования бэкапа (рекомендуется); нужен и для восстановления
