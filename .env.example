# ===== САЙТ (Render → Environment, либо файл .env локально). Реальные значения в git не кладём. =====
MONGO_URI=
ADMIN_LOGIN=
ADMIN_PASS=
# ключ подписи сессий: длинная случайная строка (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# общий ключ сайта и агента в лицее (в agent.env такой же)
AGENT_API_KEY=
TG_TOKEN=
BOT_USERNAME=
ADMIN_TG_SECRET=

# необязательно
# SKUD_NAME_MAX=32          # длина поля Name на терминале
# STAFF_IP_LIMIT=40         # заявок по ссылкам с одного IP в час
# RENDER_EXTERNAL_URL=https://pl3service.onrender.com
# REPORTS_CRON=off          # отключить авторассылку недельных/месячных отчётов в Telegram
# PORT=3000                 # порт (Render задаёт сам)
